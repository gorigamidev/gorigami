---
// Hallmark · footer: Ft2 Inline single line · design-system: design.md
---

<footer id="main-foot">
	<div class="footer-rule"></div>
	<p class="footer-line">
		<a href="/" class="foot-logo">gorigami<span class="dot">.</span></a>
		<span class="sep" aria-hidden="true">·</span>
		<a href="/terms" data-i18n="footer.terms">Terms & Conditions</a>
		<span class="sep" aria-hidden="true">·</span>
		<a
			href="https://www.linkedin.com/company/gorigami/"
			target="_blank"
			data-i18n="footer.careers">Careers</a
		>
		<span class="sep" aria-hidden="true">·</span>
		<span class="footer-tag" data-i18n="footer.tagline">Create & Innovate</span>
	</p>
</footer>

<style>
	/* Hallmark · genre: modern-minimal · footer: Ft2 Inline single line · design-system: design.md */
	#main-foot {
		padding: var(--space-xl) 10%;
		background: var(--midnight-violet);
		width: 100%;
	}

	.footer-rule {
		max-width: 1200px;
		margin: 0 auto var(--space-lg);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.footer-line {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-sm);
		font-size: 0.9rem;
	}

	.foot-logo {
		font-family: var(--logo-font);
		font-size: 1.15rem;
		color: var(--lavender-mist);
		font-weight: normal;
	}

	.dot {
		color: var(--sandy-brown);
	}

	.sep {
		color: rgba(255, 255, 255, 0.3);
	}

	footer a {
		color: var(--lavender-mist);
		text-decoration: none;
		transition: color 0.2s var(--ease-out);
	}

	footer a:hover {
		color: var(--sandy-brown);
	}

	.footer-tag {
		color: var(--lavender-mist);
		opacity: 0.7;
	}

	@media screen and (max-width: 768px) {
		#main-foot {
			padding: var(--space-lg) 1.5rem;
		}

		.footer-line {
			flex-direction: column;
			gap: 0.6rem;
		}

		.sep {
			display: none;
		}
	}
</style>
