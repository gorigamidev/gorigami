---
// Hallmark · nav: N5 Floating pill · design-system: design.md
import LanguageSwitcher from "./LanguageSwitcher.astro";
---

<nav id="main-nav" aria-label="Primary">
	<div id="logo">
		<a href="/"><h2>gorigami<span>.</span></h2></a>
	</div>
	<div id="links">
		<ul>
			<li>
				<a href="/#what-we-build" data-i18n="nav.whatWeBuild">Build</a>
			</li>
			<li><a href="/#team" data-i18n="nav.team">Team</a></li>
			<li><a href="/#contact" data-i18n="nav.contact">Contact</a></li>
		</ul>
		<LanguageSwitcher />
	</div>
</nav>

<nav id="mobile-nav" aria-label="Primary">
	<div id="logo">
		<a href="/"><h2>gg<span>.</span></h2></a>
	</div>
	<div id="links">
		<ul>
			<li>
				<a href="/#what-we-build" data-i18n="nav.whatWeBuild">Build</a>
			</li>
			<li><a href="/#team" data-i18n="nav.team">Team</a></li>
			<li><a href="/#contact" data-i18n="nav.contact">Contact</a></li>
		</ul>
		<LanguageSwitcher />
	</div>
</nav>

<style>
	/* Hallmark · genre: modern-minimal · nav: N5 Floating pill · design-system: design.md */
	#mobile-nav {
		display: none;
	}

	/* N5 Floating nav — detached, content-sized, blur backdrop, hard-edged to match the brand's cards/buttons */
	#main-nav {
		display: inline-flex;
		align-items: center;
		gap: var(--space-lg);
		position: fixed;
		top: var(--space-md);
		left: 50%;
		transform: translateX(-50%);
		z-index: 100;
		padding: 0.75rem 1.75rem;
		background: color-mix(in oklch, var(--color-paper) 78%, transparent);
		border: 1px solid var(--light-gray);
		border-radius: var(--radius-card);
		backdrop-filter: blur(14px) saturate(120%);
		-webkit-backdrop-filter: blur(14px) saturate(120%);
		box-shadow: 0 8px 24px -12px oklch(0% 0 0 / 0.18);
	}

	/* Logo uses Nautilus font */
	#logo {
		font-family: var(--logo-font);
		color: var(--ink-black);
		font-size: 1.35rem;
		margin: 0;
	}

	#logo > a {
		text-decoration: none;
		color: var(--ink-black);
	}

	#logo h2 {
		margin: 0;
		font-weight: normal;
		font-family: var(--logo-font);
	}

	#logo span {
		color: var(--mid-gray);
	}

	/* Links use body font */
	#links {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		font-family: var(--body-font);
		font-weight: 500;
	}

	#links ul {
		display: flex;
		gap: var(--space-lg);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	#links > ul > li {
		text-align: center;
		padding: 0;
	}

	#links a {
		text-decoration: none;
		color: var(--ink-black);
		font-size: 0.9rem;
		white-space: nowrap;
		transition: color 0.2s var(--ease-out);
		position: relative;
	}

	#links a:hover {
		color: var(--mid-gray);
	}

	#links a::after {
		content: "";
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--ink-black);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s var(--ease-out);
	}

	#links a:hover::after {
		transform: scaleX(1);
	}

	@media screen and (max-width: 768px) {
		#main-nav {
			display: none;
		}

		#mobile-nav {
			display: flex;
			position: fixed;
			justify-content: space-between;
			align-items: center;
			bottom: 1rem;
			left: 0.75rem;
			right: 0.75rem;
			padding: 0.85rem 1.1rem;
			background: color-mix(in oklch, var(--color-paper) 78%, transparent);
			border: 1px solid var(--light-gray);
			border-radius: var(--radius-card);
			backdrop-filter: blur(14px) saturate(120%);
			-webkit-backdrop-filter: blur(14px) saturate(120%);
			box-shadow: 0 8px 24px -12px oklch(0% 0 0 / 0.18);
			z-index: 100;
		}

		#mobile-nav #logo {
			font-size: 1.1rem;
			flex-shrink: 0;
		}

		#mobile-nav #links {
			font-size: 0.8rem;
			gap: 0.5rem;
		}

		#mobile-nav #links > ul {
			gap: 0.65rem;
		}

		#mobile-nav #links > ul > li {
			min-width: auto;
		}

		#mobile-nav #links a::after {
			display: none;
		}
	}
</style>
