---
// Hallmark · macrostructure: Split Studio (index rhythm) · design-system: design.md
import { products } from "../../data/products";
---

<section id="products">
	<div class="products-container">
		<h2 data-i18n="products.title">Tools we build and maintain</h2>
		<p class="intro" data-i18n="products.intro">
			SaaS products and open-source frameworks designed to solve real problems.
		</p>

		<div class="products-list">
			{
				products.map((product, i) => (
					<div class="product-row">
						<div class="product-index">{(i + 1).toString().padStart(2, "0")}</div>

						<div class="product-meta">
							<div class="product-header">
								<span class="product-type">{product.type}</span>
								<span
									class={`product-status status-${product.status.toLowerCase().replace(" ", "-")}`}
									data-i18n={
										product.status === "Ready"
											? "status.ready"
											: product.status === "Preview"
												? "status.preview"
												: "status.comingSoon"
									}
								>
									{product.status}
								</span>
							</div>
							<h3 data-i18n-field="name">{product.name}</h3>
							<p class="product-tagline" data-i18n-field="tagline">
								{product.tagline}
							</p>
						</div>

						<div class="product-body">
							<p class="product-description" data-i18n-field="description">
								{product.description}
							</p>
							<div class="product-links">
								{product.link && (
									<a
										href={product.link}
										target="_blank"
										class="product-link"
										data-i18n-field="cta_text"
									>
										{product.cta_text || "Learn more →"}
									</a>
								)}
								{product.infoLink && (
									<a
										href={product.infoLink}
										target="_blank"
										class="product-link product-link-secondary"
										data-i18n-field="infoLinkText"
									>
										{product.infoLinkText || "Learn more →"}
									</a>
								)}
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Hallmark · genre: modern-minimal · macrostructure: Split Studio (index rhythm) · design-system: design.md */
	#products {
		width: 100%;
		padding: var(--space-4xl) 10%;
		background: var(--paper-white);
		border-top: 1px solid var(--light-gray);
	}

	.products-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	#products h2 {
		font-size: var(--text-3xl);
		color: var(--midnight-violet);
		margin-bottom: var(--space-md);
		font-weight: 700;
	}

	.intro {
		font-size: var(--text-lg);
		color: var(--mid-gray);
		margin-bottom: var(--space-3xl);
		max-width: 600px;
	}

	.products-list {
		display: flex;
		flex-direction: column;
	}

	.product-row {
		display: grid;
		grid-template-columns: 3.5rem 1fr 1.3fr;
		gap: var(--space-lg);
		padding: var(--space-xl) 0;
		border-top: 1px solid var(--light-gray);
		transition: border-color 0.3s var(--ease-out);
	}

	.products-list > .product-row:last-child {
		border-bottom: 1px solid var(--light-gray);
	}

	.product-row:hover {
		border-color: var(--sandy-brown);
	}

	.product-index {
		font-family: var(--heading-font);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--light-gray);
		line-height: 1;
		transition: color 0.3s var(--ease-out);
	}

	.product-row:hover .product-index {
		color: var(--sandy-brown);
	}

	.product-header {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin-bottom: var(--space-2xs);
	}

	.product-type {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--mid-gray);
	}

	.product-status {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-badge);
	}

	.status-ready {
		background: var(--sandy-brown);
		color: var(--paper-white);
	}

	.status-coming-soon {
		background: var(--lavender-mist);
		color: var(--midnight-violet);
	}
	.status-preview {
		background: var(--midnight-violet);
		color: var(--paper-white);
	}

	.product-meta h3 {
		font-size: var(--text-2xl);
		color: var(--midnight-violet);
		font-weight: 700;
		margin: 0 0 var(--space-3xs);
	}

	.product-tagline {
		font-size: 1rem;
		color: var(--sandy-brown);
		font-weight: 500;
		margin: 0;
	}

	.product-description {
		font-size: 0.95rem;
		color: var(--mid-gray);
		line-height: 1.7;
		margin: 0 0 var(--space-sm);
	}

	.product-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-lg);
	}

	.product-link {
		display: inline-block;
		color: var(--midnight-violet);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
	}

	.product-link:hover {
		color: var(--sandy-brown);
		transform: translateX(4px);
	}

	.product-link-secondary {
		color: var(--mid-gray);
		font-weight: 500;
	}

	.product-link-secondary:hover {
		color: var(--midnight-violet);
	}

	/* Tablet */
	@media screen and (max-width: 1024px) {
		.product-row {
			grid-template-columns: 2.5rem 1fr;
		}

		.product-body {
			grid-column: 2 / -1;
		}
	}

	/* Mobile */
	@media screen and (max-width: 768px) {
		#products {
			padding: var(--space-2xl) 1.5rem;
		}

		#products h2 {
			font-size: var(--text-2xl);
		}

		.intro {
			font-size: 1.1rem;
		}

		.product-row {
			grid-template-columns: 1fr;
			gap: var(--space-xs);
		}

		.product-body {
			grid-column: auto;
		}

		.product-index {
			font-size: var(--text-lg);
		}
	}
</style>
