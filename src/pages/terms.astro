---
import Layout from "../layouts/Layout.astro";
import TermsConditions from "../components/common/TermsConditions.md";
---

<Layout
	title="Términos & Condiciones"
	description="Read Gorigami's Terms and Conditions, privacy policies, and service agreements. Transparent and clear."
>
	<main id="termns">
		<TermsConditions />
	</main>
</Layout>
<style>
	#termns {
		width: 100%;
		min-height: 100vh;
		padding: 6.5rem 10% 4rem 10%;
		text-align: left;
		line-height: 2rem;
		font-family: var(--body-font);
		display: flex;
		flex-direction: column;
		justify-content: start;
		gap: 1rem;
	}
</style>
