---
import Layout from "../layouts/Layout.astro";
import TermsConditions from "../components/common/TermsConditions.md";
---

<Layout
	title="Términos & Condiciones"
	description="Read Gorigami's Terms and Conditions, privacy policies, and service agreements. Transparent and clear."
>
	<main id="termns">
		<div class="terms-doc">
			<TermsConditions />
		</div>
	</main>
</Layout>
<style is:global>
	/* Hallmark · genre: modern-minimal · macrostructure: Long Document · design-system: design.md */
	#termns {
		width: 100%;
		min-height: 100vh;
		padding: var(--space-4xl) 1.5rem var(--space-2xl);
		display: flex;
		justify-content: center;
	}

	#termns .terms-doc {
		width: 100%;
		max-width: 65ch;
		color: var(--mid-gray);
		font-family: var(--body-font);
		line-height: 1.75;
	}

	#termns .terms-doc h1 {
		font-size: var(--text-3xl);
		color: var(--midnight-violet);
		margin-bottom: var(--space-2xs);
	}

	#termns .terms-doc h2 {
		font-size: var(--text-xl);
		color: var(--midnight-violet);
		margin: var(--space-xl) 0 var(--space-xs);
	}

	#termns .terms-doc h3 {
		font-size: var(--text-md);
		color: var(--midnight-violet);
		margin: var(--space-lg) 0 var(--space-2xs);
	}

	#termns .terms-doc p,
	#termns .terms-doc ul,
	#termns .terms-doc ol {
		margin-bottom: var(--space-sm);
	}

	#termns .terms-doc li {
		margin-left: var(--space-md);
	}
</style>
